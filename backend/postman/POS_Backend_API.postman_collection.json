	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Global pre-request script",
					"// This runs before every request",
					"",
					"// Check if we have an access token (except for auth endpoints)",
					"const isAuthEndpoint = pm.request.url.toString().includes('/auth/');",
					"const isHealthEndpoint = pm.request.url.toString().includes('/health') || pm.request.url.toString().includes('/metrics');",
					"",
					"if (!isAuthEndpoint && !isHealthEndpoint) {",
					"    const accessToken = pm.environment.get('access_token');",
					"    ",
					"    if (!accessToken) {",
					"        console.warn('⚠️ No access token found. Please run the Login request first.');",
					"    } else {",
					"        console.log('✅ Access token found and will be used for authentication');",
					"    }",
					"}",
					"",
					"// Log request details",
					"console.log(`🚀 ${pm.request.method} ${pm.request.url.toString()}`);"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Global test script",
					"// This runs after every request",
					"",
					"// Log response details",
					"console.log(`📥 Response Status: ${pm.response.code} ${pm.response.status}`);",
					"console.log(`⏱️ Response Time: ${pm.response.responseTime}ms`);",
					"",
					"// Check for common error scenarios",
					"if (pm.response.code === 401) {",
					"    console.error('🔒 Unauthorized - Access token may be expired. Try refreshing or logging in again.');",
					"}",
					"",
					"if (pm.response.code === 403) {",
					"    console.error('🚫 Forbidden - You do not have permission for this action.');",
					"}",
					"",
					"if (pm.response.code === 429) {",
					"    console.error('⏳ Rate Limited - Too many requests. Please wait before trying again.');",
					"}",
					"",
					"// Parse and display error details if present",
					"if (pm.response.code >= 400) {",
					"    try {",
					"        const error = pm.response.json();",
					"        if (error.error && error.message) {",
					"            console.error(`❌ Error: ${error.error} - ${error.message}`);",
					"            if (error.details) {",
					"                console.error('Details:', JSON.stringify(error.details, null, 2));",
					"            }",
					"        }",
					"    } catch (e) {",
					"        // Not JSON or couldn't parse",
					"    }",
					"}"
				]
			}
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080",
			"type": "default"
		}
	]
