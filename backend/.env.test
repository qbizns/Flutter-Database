# Test Environment Configuration
# This file is used for automated testing
# DO NOT use in production!

# Server Configuration
SERVER_ENV=test
SERVER_HOST=localhost
SERVER_PORT=8081
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s

# Database Configuration (Test)
DB_HOST=localhost
DB_PORT=5433
DB_USER=pos_test_user
DB_PASSWORD=pos_test_password
DB_NAME=pos_test
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=5m
DB_MAX_CONN_IDLE_TIME=1m
DB_QUERY_TIMEOUT=5s

# SSL Configuration (Disabled for testing)
DB_SSL_MODE=disable
DB_SSL_ROOT_CERT=
DB_SSL_CERT=
DB_SSL_KEY=

# JWT Configuration (Test)
JWT_SECRET=test-secret-key-for-automated-testing-only-minimum-32-chars
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=24h

# Redis Configuration (Test)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Request-ID,X-CSRF-Token

# Rate Limiting (Test - More permissive)
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Feature Flags (Test)
ENABLE_METRICS=false
ENABLE_TRACING=false
ENABLE_RATE_LIMITING=true
