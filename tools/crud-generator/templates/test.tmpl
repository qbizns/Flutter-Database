func TestHandler_Create(t *testing.T) {
	repo := {{.Package}}.NewRepository(testDB, testLogger)
	service := {{.Package}}.NewService(testDB, repo, testLogger)
	handler := {{.Package}}.NewHandler(service, testLogger)

	reqBody := &dto.Create{{.GoName}}Request{
		{{range .Columns}}{{if ne .Name "id"}}{{if ne .Name "created_at"}}{{if ne .Name "updated_at"}}{{if ne .Name "deleted_at"}}{{if ne .Name "organization_id"}}
		{{if eq .GoType "string"}}{{.GoName}}: "test_value",{{end}}
		{{end}}{{end}}{{end}}{{end}}{{end}}{{end}}
	}

	body, err := json.Marshal(reqBody)
	require.NoError(t, err)

	{{if .HasOrganization}}
	req := httptest.NewRequest(http.MethodPost, "/api/v1/organizations/"+testOrgID.String()+"/{{.Name}}", strings.NewReader(string(body)))
	{{else}}
	req := httptest.NewRequest(http.MethodPost, "/api/v1/{{.Name}}", strings.NewReader(string(body)))
	{{end}}
	req.Header.Set("Content-Type", "application/json")
	{{if .HasOrganization}}
	req = testutil.WithOrgID(req, testOrgID)
	{{end}}

	w := httptest.NewRecorder()
	handler.Create(w, req)

	assert.Equal(t, http.StatusCreated, w.Code)

	var resp dto.{{.GoName}}Response
	err = json.Unmarshal(w.Body.Bytes(), &resp)
	assert.NoError(t, err)
	assert.NotEqual(t, uuid.Nil, resp.ID)
}

