		WHERE {{.PrimaryKey}} = $1
		AND deleted_at IS NULL
	`

	tag, err := tx.Exec(ctx, query, id)
	if err != nil {
		r.logger.Error("failed to delete {{.Name}}", zap.Error(err), zap.String("id", id.String()))
		return fmt.Errorf("failed to delete {{.Name}}: %w", err)
	}

	if tag.RowsAffected() == 0 {
		return fmt.Errorf("{{.Name}} not found or already deleted")
	}

	r.logger.Info("deleted {{.Name}}", zap.String("id", id.String()))
	return nil
}
