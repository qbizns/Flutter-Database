// Create creates a new {{.Name}}
func (s *Service) Create(ctx context.Context, {{if .HasOrganization}}orgID uuid.UUID, {{end}}req *Create{{.GoName}}Request) (*{{.GoName}}Response, error) {
	s.logger.Info("creating {{.Name}}",
		{{if .HasOrganization}}zap.String("organization_id", orgID.String()),{{end}}
	)

	// Validate request
	if err := req.Validate(); err != nil {
		return nil, fmt.Errorf("validation failed: %w", err)
	}

	// Start transaction
	tx, err := s.db.Begin(ctx)
	if err != nil {
		return nil, fmt.Errorf("failed to begin transaction: %w", err)
	}
	defer tx.Rollback(ctx)

	{{if .HasOrganization}}
	// Set organization context for RLS
	if err := s.setOrganizationContext(ctx, tx, orgID); err != nil {
		return nil, err
	}
	{{end}}

	// Convert DTO to entity
	entity := &{{.GoName}}{
		{{if .HasOrganization}}OrganizationID: orgID,{{end}}
		{{range .Columns}}{{if ne .Name "id"}}{{if ne .Name "created_at"}}{{if ne .Name "updated_at"}}{{if ne .Name "deleted_at"}}{{if ne .Name "organization_id"}}
		{{.GoName}}: req.{{.GoName}},
		{{end}}{{end}}{{end}}{{end}}{{end}}{{end}}
	}

	// Business logic validation
	if err := s.validateBusinessRules(ctx, tx, entity); err != nil {
		return nil, err
	}

	// Create in database
	if err := s.repo.Create(ctx, tx, entity); err != nil {
		return nil, fmt.Errorf("failed to create {{.Name}}: %w", err)
	}

	// Commit transaction
	if err := tx.Commit(ctx); err != nil {
		return nil, fmt.Errorf("failed to commit transaction: %w", err)
	}

	s.logger.Info("created {{.Name}}",
		zap.String("id", entity.ID.String()),
		{{if .HasOrganization}}zap.String("organization_id", orgID.String()),{{end}}
	)

	return s.entityToResponse(entity), nil
}

