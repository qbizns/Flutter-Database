// List retrieves a paginated list of {{.Name}} records
func (s *Service) List(ctx context.Context, {{if .HasOrganization}}orgID uuid.UUID, {{end}}page, limit int) (*{{.GoName}}ListResponse, error) {
	s.logger.Debug("listing {{.Name}}",
		{{if .HasOrganization}}zap.String("organization_id", orgID.String()),{{end}}
		zap.Int("page", page),
		zap.Int("limit", limit),
	)

	// Validate pagination
	if page < 1 {
		page = 1
	}
	if limit < 1 || limit > 100 {
		limit = 20
	}

	offset := (page - 1) * limit

	// Start transaction (read-only)
	tx, err := s.db.Begin(ctx)
	if err != nil {
		return nil, fmt.Errorf("failed to begin transaction: %w", err)
	}
	defer tx.Rollback(ctx)

	{{if .HasOrganization}}
	// Set organization context for RLS
	if err := s.setOrganizationContext(ctx, tx, orgID); err != nil {
		return nil, err
	}

	// Get from database (organization-scoped)
	entities, total, err := s.repo.ListByOrganization(ctx, tx, orgID, limit, offset)
	{{else}}
	// Get from database
	entities, total, err := s.repo.List(ctx, tx, limit, offset)
	{{end}}
	if err != nil {
		return nil, fmt.Errorf("failed to list {{.Name}}: %w", err)
	}

	// Convert to response
	items := make([]*{{.GoName}}Response, len(entities))
	for i, entity := range entities {
		items[i] = s.entityToResponse(entity)
	}

	totalPages := (total + limit - 1) / limit

	return &{{.GoName}}ListResponse{
		Items: items,
		Pagination: Pagination{
			Page:       page,
			Limit:      limit,
			Total:      total,
			TotalPages: totalPages,
			HasNext:    page < totalPages,
			HasPrev:    page > 1,
		},
	}, nil
}

